---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact">
  <section class="page-hero ledger-field">
    <div class="wrap" style="position:relative; z-index:1;">
      <span class="eyebrow">Contact</span>
      <h1>Let's talk about your business</h1>
      <p class="lede">Tell us a little about what you need, and we'll get back to you within one working day.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-2">
        <div class="contact-panel">
          <h2>Send an enquiry</h2>
          <p>Fill in the form below and it'll land straight in our inbox.</p>
          <form class="enquiry" action="https://formsubmit.co/accuro.consultancy.mv@gmail.com" method="POST">
            <input type="hidden" name="_subject" value="New enquiry from Accuro website" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />
            <div class="row-2">
              <div class="field">
                <label for="name">Full name</label>
                <input id="name" name="name" type="text" placeholder="Your name" required />
              </div>
              <div class="field">
                <label for="company">Company</label>
                <input id="company" name="company" type="text" placeholder="Your business name" />
              </div>
            </div>
            <div class="row-2">
              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" placeholder="you@company.com" required />
              </div>
              <div class="field">
                <label for="phone">Phone / WhatsApp</label>
                <input id="phone" name="phone" type="tel" placeholder="+960" />
              </div>
            </div>
            <div class="field">
              <label for="service">What do you need help with?</label>
              <select id="service" name="service">
                <option>Business registration</option>
                <option>Tax return preparation &amp; GST compliance</option>
                <option>Financial statements &amp; reporting</option>
                <option>Investment &amp; funding advisory</option>
                <option>SME Digital financing facilitation</option>
                <option>Legal advisory</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="field">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us a bit about your business and what you're looking for" required></textarea>
            </div>
            <button class="btn btn-primary" type="submit">Send enquiry</button>
          </form>
        </div>

        <div>
          <h2>Reach us directly</h2>
          <p><strong>Email:</strong> <a href="mailto:accuro.consultancy.mv@gmail.com">accuro.consultancy.mv@gmail.com</a></p>
          <p><strong>Based in:</strong> Maldives</p>
         <p><strong>WhatsApp:</strong> <a href="https://wa.me/9609798466" target="_blank" rel="noopener">+960 979-8466</a></p>
          <p><strong>Instagram:</strong> <a href="https://instagram.com/accuro_consultancy" target="_blank" rel="noopener">@accuro_consultancy</a></p>
          <p style="margin-top:32px;">We typically respond within one working day. For urgent enquiries, Whatsapp is the fastest way to reach us right now.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
