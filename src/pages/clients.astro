---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Clients">
  <section class="page-hero ledger-field">
    <div class="wrap" style="position:relative; z-index:1;">
      <span class="eyebrow">Clients &amp; Portfolio</span>
      <h1>Businesses we've helped register, fund and stay compliant</h1>
      <p class="lede">A snapshot of the sectors and projects we've supported across the Maldives.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        <div class="card">
          <span class="index">Sector</span>
          <h3>Hospitality &amp; Guest Houses</h3>
          <p>Business registration, tax compliance and guest house financing applications.</p>
        </div>
        <div class="card">
          <span class="index">Sector</span>
          <h3>Retail &amp; SMEs</h3>
          <p>Incorporation, GST return filing and SDFC funding proposals for growing businesses.</p>
        </div>
        <div class="card">
          <span class="index">Sector</span>
          <h3>Professional Services</h3>
          <p>Investment appraisal, financial modelling and legal advisory for expansion planning.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What clients say</span>
        <h2>In their words</h2>
      </div>
      <div class="grid grid-3">
        <div class="quote-card">
          <p>"Accuro handled our entire registration process. What felt overwhelming became straightforward."</p>
          <div class="quote-attr">— Founder, Guest House Business</div>
        </div>
        <div class="quote-card">
          <p>"Their tax and GST filing support gave us peace of mind we simply didn't have before."</p>
          <div class="quote-attr">— Founder, Real estate Business</div>
        </div>
        <div class="quote-card">
          <p>"Clear, patient, and genuinely invested in getting our numbers right. The proposal they prepared was flawless"</p>
          <div class="quote-attr">— Founder, SME</div>
        </div>
      </div>
      <p style="margin-top:24px; font-size:0.85rem;">Client names withheld by request. Case studies available on request during a consultation.</p>
    </div>
  </section>

  <section class="section" style="text-align:center;">
    <div class="wrap">
      <h2>Become our next success story</h2>
      <a class="btn btn-primary" href="/contact">Book a consultation</a>
    </div>
  </section>
</Layout>
