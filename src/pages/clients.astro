---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Clients">
  <section class="page-hero ledger-field">
    <div class="wrap" style="position:relative; z-index:1;">
      <span class="eyebrow">Clients &amp; Portfolio</span>
      <h1>Businesses we've helped bring clarity to their numbers</h1>
      <p class="lede">A snapshot of the sectors and projects we've supported across the Maldives.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        <div class="card">
          <span class="index">Sector</span>
          <h3>Hospitality &amp; Resorts</h3>
          <p>Revenue dashboards, budgeting cycles and management reporting for resort operators.</p>
        </div>
        <div class="card">
          <span class="index">Sector</span>
          <h3>Retail &amp; SMEs</h3>
          <p>Bookkeeping clean-ups, cash flow tracking and simplified monthly reporting.</p>
        </div>
        <div class="card">
          <span class="index">Sector</span>
          <h3>Professional Services</h3>
          <p>Financial modelling for growth planning and pricing strategy.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What clients say</span>
        <h2>In their words</h2>
      </div>
      <div class="grid grid-3">
        <div class="quote-card">
          <p>"Accuro rebuilt our entire budgeting process. What used to take days now takes an afternoon."</p>
          <div class="quote-attr">— Operations Lead, Resort &amp; Hospitality Group</div>
        </div>
        <div class="quote-card">
          <p>"Their dashboard gave our management team visibility we simply didn't have before."</p>
          <div class="quote-attr">— Finance Manager, Retail Business</div>
        </div>
        <div class="quote-card">
          <p>"Clear, patient, and genuinely invested in getting our numbers right."</p>
          <div class="quote-attr">— Founder, SME</div>
        </div>
      </div>
      <p style="margin-top:24px; font-size:0.85rem;">Client names withheld by request. Case studies available on request during a consultation.</p>
    </div>
  </section>

  <section class="section" style="text-align:center;">
    <div class="wrap">
      <h2>Become our next success story</h2>
      <a class="btn btn-primary" href="/contact">Book a consultation</a>
    </div>
  </section>
</Layout>
