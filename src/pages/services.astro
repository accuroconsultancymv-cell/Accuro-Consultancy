---
import Layout from '../layouts/Layout.astro';
const services = [
  {
    n: '01',
    title: 'Business Registration',
    body: 'End-to-end business registration support, including preparation of incorporation documents and coordination of corporate bank account setup.'
  },
  {
    n: '02',
    title: 'Tax Return Preparation & GST Compliance',
    body: 'Comprehensive tax compliance support \u2014 from finalisation of annual financial statements to accurate, timely Income Tax and GST return submissions.'
  },
  {
    n: '03',
    title: 'Financial Statements & Reporting',
    body: 'Preparation of financial statements, return filing and deadline reminders, so nothing slips through the cracks.'
  },
  {
    n: '04',
    title: 'Investment & Funding Advisory',
    body: 'Structuring loan proposals and delivering data-driven investment appraisal and forward-looking financial models to support your funding applications.'
  },
  {
    n: '05',
    title: 'SDFC Financing Facilitation',
    body: 'Strategically structured funding proposals \u2014 with robust forecasts, risk assessments and ROI analysis \u2014 across SDFC\u2019s Islamic and conventional financing schemes.'
  },
  {
    n: '06',
    title: 'Legal Advisory',
    body: 'Integrated legal advisory for strategic and regulatory excellence, keeping your business compliant as it grows.'
  },
];
---
<Layout title="Services">
  <section class="page-hero ledger-field">
    <div class="wrap" style="position:relative; z-index:1;">
      <span class="eyebrow">Services</span>
      <h1>Precision. Governance. Growth.</h1>
      <p class="lede">Empowering individuals and businesses with bespoke financial strategies
        for a stronger financial future — engage us for a single service or ongoing
        support across registration, tax, funding and legal matters.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        {services.map((s) => (
          <div class="card">
            <span class="index">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="text-align:center;">
      <h2>Not sure which service fits your business?</h2>
      <p style="max-width:52ch; margin:0 auto 28px;">Tell us what you're working with, and we'll recommend the right starting point.</p>
      <a class="btn btn-primary" href="/contact">Book a consultation</a>
    </div>
  </section>
</Layout>
