---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home">
  <section class="hero ledger-field">
    <div class="wrap" style="position:relative; z-index:1;">
      <span class="eyebrow">Financial &amp; Business Consultancy · Maldives</span>
      <h1>Building your future, one smart decision at a time.</h1>
      <p class="lede">
        Accuro Consultancy empowers individuals and businesses with bespoke financial
        strategies — from business registration and tax compliance to funding advisory
        and legal support — delivered with precision, governance and growth in mind.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/contact">Book a consultation</a>
        <a class="btn btn-outline" href="/services">See our services</a>
      </div>

      <div class="kpi-row">
        <div class="kpi-select" aria-hidden="true"></div>
        <div class="kpi-cell">
          <span class="num">10+</span>
          <span class="label">Years combined advisory experience</span>
        </div>
        <div class="kpi-cell">
          <span class="num">40+</span>
          <span class="label">Businesses supported across the Maldives</span>
        </div>
        <div class="kpi-cell">
          <span class="num">100%</span>
          <span class="label">Focused on accuracy, governance and growth</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Advisory support, end to end</h2>
        <p>From registering your business to keeping it compliant and funded, we
          handle the paperwork and the strategy — so you can focus on running it.</p>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <span class="index">01</span>
          <h3>Business Registration</h3>
          <p>End-to-end registration support, including incorporation documents and corporate bank account setup.</p>
        </div>
        <div class="card">
          <span class="index">02</span>
          <h3>Tax &amp; GST Compliance</h3>
          <p>Financial statement finalisation and accurate, timely Income Tax and GST return submissions.</p>
        </div>
        <div class="card">
          <span class="index">03</span>
          <h3>Investment &amp; Funding Advisory</h3>
          <p>Loan proposals, financial models and SDFC financing applications backed by data-driven appraisal.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="grid grid-2" style="align-items:center;">
        <div>
          <span class="eyebrow" style="font-family:var(--font-mono); font-size:0.78rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--gold-deep);">Funding schemes</span>
          <h2>SDFC financing, structured and submitted for you</h2>
          <p>We prepare strategically structured funding proposals — with robust
            forecasts, risk assessments and ROI analysis — across SDFC's Islamic and
            conventional financing schemes, to maximise your approval potential.</p>
          <a class="btn btn-outline" href="/services">See all services →</a>
        </div>
        <div class="grid grid-2" style="gap:16px;">
          <div class="card">
            <span class="index">Islamic</span>
            <h3 style="font-size:1rem;">Murabaha, Thijarah &amp; Asset Financing</h3>
          </div>
          <div class="card">
            <span class="index">Conventional</span>
            <h3 style="font-size:1rem;">Business Expansion Facility</h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Trusted by</span>
        <h2>Working with businesses across the Maldives</h2>
      </div>
      <div class="grid grid-3">
        <div class="quote-card">
          <p>"Accuro handled our entire registration process. What felt overwhelming became straightforward."</p>
          <div class="quote-attr">— Founder, Guest House Business</div>
        </div>
        <div class="quote-card">
          <p>"Their tax and GST filing support gave us peace of mind we simply didn't have before."</p>
          <div class="quote-attr">— Finance Manager, Retail Business</div>
        </div>
        <div class="quote-card">
          <p>"Clear, patient, and genuinely invested in getting our numbers right."</p>
          <div class="quote-attr">— Founder, SME</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap" style="text-align:center;">
      <h2>Let's build your future, one smart decision at a time</h2>
      <p style="max-width:52ch; margin:0 auto 28px;">Tell us where your business is today, and we'll help you plan the path forward.</p>
      <a class="btn btn-primary" href="/contact">Book a consultation</a>
    </div>
  </section>
</Layout>
