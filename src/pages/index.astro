---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home">
  <section class="hero ledger-field">
    <div class="wrap" style="position:relative; z-index:1;">
      <span class="eyebrow">Financial &amp; Business Consultancy · Maldives</span>
      <h1>Clarity in your numbers. Confidence in your decisions.</h1>
      <p class="lede">
        Accuro Consultancy helps Maldivian businesses plan, budget, model and report
        with precision — through hands-on advisory work and ready-to-use Excel tools
        built for how you actually work.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/contact">Book a consultation</a>
        <a class="btn btn-outline" href="/templates">Browse Excel templates</a>
      </div>

      <div class="kpi-row">
        <div class="kpi-select" aria-hidden="true"></div>
        <div class="kpi-cell">
          <span class="num">10+</span>
          <span class="label">Years combined advisory experience</span>
        </div>
        <div class="kpi-cell">
          <span class="num">40+</span>
          <span class="label">Businesses supported across the Maldives</span>
        </div>
        <div class="kpi-cell">
          <span class="num">100%</span>
          <span class="label">Templates built for real operational use</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Advisory and tools, in one place</h2>
        <p>From first-time budgets to full management reporting systems, we work
          alongside your team — then leave you with tools you can run yourself.</p>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <span class="index">01</span>
          <h3>Financial Planning &amp; Modelling</h3>
          <p>Forecasts, scenarios and models built to support real decisions — not just to sit in a drawer.</p>
        </div>
        <div class="card">
          <span class="index">02</span>
          <h3>Budgeting, Bookkeeping &amp; Reporting</h3>
          <p>Clean, accurate books and management reports that tell you exactly where your business stands.</p>
        </div>
        <div class="card">
          <span class="index">03</span>
          <h3>Excel Automation &amp; Dashboards</h3>
          <p>We turn manual spreadsheet work into automated, error-resistant systems and live dashboards.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="grid grid-2" style="align-items:center;">
        <div>
          <span class="eyebrow" style="font-family:var(--font-mono); font-size:0.78rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--signal-blue);">Templates</span>
          <h2>Excel templates, built to be used — not just admired</h2>
          <p>Every template is built from real consultancy work: budgeting trackers, cash flow
            models, dashboard starters and more. Some are free to download. Others are premium,
            fully built systems ready to plug into your business.</p>
          <a class="btn btn-outline" href="/templates">See all templates →</a>
        </div>
        <div class="grid grid-2" style="gap:16px;">
          <div class="template-card">
            <div class="template-thumb"></div>
            <div class="template-body">
              <span class="template-tag">Free</span>
              <h3 style="font-size:1rem;">Monthly Cash Flow Tracker</h3>
            </div>
          </div>
          <div class="template-card">
            <div class="template-thumb"></div>
            <div class="template-body">
              <span class="template-tag premium">Premium</span>
              <h3 style="font-size:1rem;">3-Statement Financial Model</h3>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Trusted by</span>
        <h2>Working with businesses across the Maldives</h2>
      </div>
      <div class="grid grid-3">
        <div class="quote-card">
          <p>"Accuro rebuilt our entire budgeting process. What used to take days now takes an afternoon."</p>
          <div class="quote-attr">— Operations Lead, Resort &amp; Hospitality Group</div>
        </div>
        <div class="quote-card">
          <p>"Their dashboard gave our management team visibility we simply didn't have before."</p>
          <div class="quote-attr">— Finance Manager, Retail Business</div>
        </div>
        <div class="quote-card">
          <p>"Clear, patient, and genuinely invested in getting our numbers right."</p>
          <div class="quote-attr">— Founder, SME</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap" style="text-align:center;">
      <h2>Let's get your numbers working for you</h2>
      <p style="max-width:52ch; margin:0 auto 28px;">Tell us where your business is today, and we'll help you plan the path forward.</p>
      <a class="btn btn-primary" href="/contact">Book a consultation</a>
    </div>
  </section>
</Layout>
